# Скопируйте этот файл в .env и заполните.

PORT=3000
# Секрет для админ-запросов (ручное обновление рынка через API). Длинная случайная строка.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Файл базы данных SQLite
DB_FILE=./data/finbrain.db

# --- AI (достаточно одного ключа; если заданы оба, при лимите идёт переключение) ---
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Лимит AI-запросов на одного пользователя в час
AI_PER_HOUR=20

# --- Биржевые котировки (необязательно) ---
# Finnhub: https://finnhub.io/register — бесплатный ключ
FINNHUB_API_KEY=

# Время ежедневного обновления рынка (cron, часовой пояс ниже)
MARKET_CRON=17 8 * * *
TZ_MARKET=Asia/Yerevan

# true — ставить cookie только по HTTPS (включите на сервере с HTTPS)
COOKIE_SECURE=false

# --- Напоминания в Telegram (необязательно) ---
# Создайте бота у @BotFather и вставьте токен
TELEGRAM_BOT_TOKEN=
# Когда отправлять напоминания (cron, часовой пояс TZ_MARKET)
REMINDER_CRON=0 9 * * *
